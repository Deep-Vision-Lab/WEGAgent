        },
        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/m4a1JPSc4QaJgGlK.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_22_2.jpg"
        },

        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/qGuLXVxPvXFVbGbq.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_16_1.jpg"
        },
        {

          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_16_2.jpg"
        },
        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/OBPBQYxdewuW5vZJ.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_16_3.jpg"
        }
      ]
    },
    {
      "step_index": 17,
      "step_id_ifixit": 354041,
      "full_description": "- Pinch the rear portion of the air return cover to release it from the freezer wall.\n- Pull the air return cover outward and remove it.",

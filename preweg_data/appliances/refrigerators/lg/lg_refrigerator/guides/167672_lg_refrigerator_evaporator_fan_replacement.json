          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_21_3.jpg"
        }
      ]
    },
    {
      "step_index": 22,
      "step_id_ifixit": 354046,
      "full_description": "- Swing the left edge of the evaporator cover further toward you to access the connections in the upper right corner.\n- Squeeze and pull the connector to disconnect the thermistor mounted in the evaporator cover.",
      "images": [
        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/s5JeSFcBC1MP2MKp.standard",

          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_23_1.jpg"
        },
        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/bldbQ3rGVRLJbbEG.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_23_2.jpg"
        }
      ]
    },

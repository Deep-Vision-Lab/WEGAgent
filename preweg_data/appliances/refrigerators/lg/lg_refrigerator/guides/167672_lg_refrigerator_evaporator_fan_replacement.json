        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/y1rYGHhWIJNLAPWg.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_25_1.jpg"
        },
        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/cXdHtCfiJTsQKpwN.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_25_2.jpg"
        },
        {
          "src_url": "https://guide-images.cdn.ifixit.com/igi/SeiQGDIosXdX5y3m.standard",
          "saved_path": "preweg_data/appliances/refrigerators/lg/lg_refrigerator/imgs/guide_167672_step_25_3.jpg"
        }
      ]
    },
    {
      "step_index": 26,
      "step_id_ifixit": 354081,
      "full_description": "- Cut any cable ties securing the motor wires to the evaporator fan assembly.\n- Unhook the motor wires from the evaporator fan assembly.",
